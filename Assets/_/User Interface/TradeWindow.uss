.trade-window {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    flex-direction: column;
    align-items: stretch;
    background-color: rgb(28, 26, 30);
    color: rgb(235, 232, 236);
}

.trade-window__panel {
    flex-grow: 1;
    flex-direction: column;
    align-items: stretch;
    padding: 20px 24px 16px;
    min-height: 0;
}

.trade-window__header {
    flex-direction: column;
    align-items: stretch;
    margin-bottom: 16px;
    flex-shrink: 0;
}

.trade-window__title {
    width: 100%;
    margin-bottom: 12px;
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(245, 245, 247);
    letter-spacing: 1px;
}

.trade-window__tabs-row {
    flex-direction: row;
    align-items: center;
    width: 100%;
}

.trade-window__tabs-row-side {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
}

.trade-window__tabs-row-side--end {
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
}

.trade-window__close-button {
    width: 32px;
    height: 32px;
    min-width: 32px;
    border-width: 0;
    border-radius: 8px;
    margin: 0;
    padding: 0;
    background-color: rgb(52, 48, 54);
    color: rgb(200, 196, 202);
    font-size: 16px;
    -unity-font-style: bold;
}

.trade-window__close-button:hover {
    background-color: rgb(72, 68, 74);
    color: rgb(245, 245, 247);
}

.trade-window__tabs {
    flex-direction: row;
    align-items: center;
    border-radius: 8px;
    background-color: rgb(42, 39, 44);
    padding: 3px;
}

.trade-window__tab {
    min-width: 88px;
    height: 32px;
    border-width: 0;
    border-radius: 6px;
    margin: 0;
    padding-left: 14px;
    padding-right: 14px;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(170, 166, 172);
    font-size: 13px;
}

.trade-window__tab--active {
    background-color: rgb(62, 58, 66);
    color: rgb(245, 245, 247);
    -unity-font-style: bold;
}

.trade-window__content {
    flex-grow: 1;
    flex-direction: column;
    align-items: stretch;
    min-height: 0;
}

.trade-window__tab-panel {
    flex-grow: 1;
    flex-direction: column;
    align-items: stretch;
    min-height: 0;
}

.trade-window__tab-panel--hidden {
    display: none;
}

.trade-window__scroll {
    flex-grow: 1;
    min-height: 0;
    margin-bottom: 12px;
}

.trade-window__list {
    flex-direction: column;
    align-items: stretch;
}

.trade-window__empty-label {
    flex-grow: 1;
    -unity-text-align: middle-center;
    color: rgb(140, 136, 142);
    font-size: 13px;
    margin-top: 24px;
    margin-bottom: 24px;
}

.trade-window__summary {
    flex-direction: row;
    align-items: stretch;
    justify-content: space-between;
    padding: 12px 14px;
    border-radius: 10px;
    background-color: rgb(38, 36, 40);
    border-width: 1px;
    border-color: rgb(58, 54, 60);
    margin-bottom: 12px;
    flex-shrink: 0;
}

.trade-window__summary--compact {
    margin-bottom: 0;
}

.trade-window__summary-group {
    flex-grow: 1;
    flex-direction: column;
    align-items: center;
    margin-left: 4px;
    margin-right: 4px;
}

.trade-window__summary-group--highlight {
    padding: 4px 6px;
    border-radius: 6px;
    background-color: rgba(90, 200, 250, 0.08);
}

.trade-window__summary-label {
    font-size: 10px;
    color: rgb(150, 146, 152);
    -unity-text-align: middle-center;
    margin-bottom: 4px;
    letter-spacing: 0.3px;
}

.trade-window__summary-value {
    font-size: 14px;
    color: rgb(220, 216, 222);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.trade-window__summary-value--accent {
    color: rgb(120, 210, 255);
}

.trade-window__confirm-button {
    height: 48px;
    border-width: 0;
    border-radius: 10px;
    margin: 0;
    padding: 0 20px;
    background-color: rgb(72, 168, 96);
    color: rgb(255, 255, 255);
    font-size: 15px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    flex-shrink: 0;
}

.trade-window__confirm-button:hover {
    background-color: rgb(92, 188, 116);
}

.trade-window__confirm-button:disabled {
    background-color: rgb(52, 48, 54);
    color: rgb(120, 116, 122);
}
