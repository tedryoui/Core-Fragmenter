.trading-window {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    flex-direction: column;
    align-items: stretch;
    background-color: rgb(28, 26, 30);
    color: rgb(235, 232, 236);
}

.trading-window__panel {
    flex-grow: 1;
    flex-direction: column;
    align-items: stretch;
    padding: 20px 24px 16px;
}

.trading-window__header {
    flex-direction: column;
    align-items: stretch;
    margin-bottom: 16px;
}

.trading-window__title {
    width: 100%;
    margin-bottom: 12px;
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(245, 245, 247);
    letter-spacing: 1px;
}

.trading-window__tabs-row {
    flex-direction: row;
    align-items: center;
    width: 100%;
}

.trading-window__tabs-row-side {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
}

.trading-window__tabs-row-side--end {
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
}

.trading-window__close-button {
    width: 32px;
    height: 32px;
    min-width: 32px;
    border-width: 0;
    border-radius: 8px;
    margin: 0;
    padding: 0;
    background-color: rgb(52, 48, 54);
    color: rgb(200, 196, 202);
    font-size: 16px;
    -unity-font-style: bold;
}

.trading-window__close-button:hover {
    background-color: rgb(72, 68, 74);
    color: rgb(245, 245, 247);
}

.trading-window__tabs {
    flex-direction: row;
    align-items: center;
    border-radius: 8px;
    background-color: rgb(42, 39, 44);
    padding: 3px;
}

.trading-window__tab {
    min-width: 88px;
    height: 32px;
    border-width: 0;
    border-radius: 6px;
    margin: 0;
    padding-left: 14px;
    padding-right: 14px;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(170, 166, 172);
    font-size: 13px;
    -unity-font-style: normal;
}

.trading-window__tab--active {
    background-color: rgb(62, 58, 66);
    color: rgb(245, 245, 247);
    -unity-font-style: bold;
}

.trading-window__content {
    flex-grow: 1;
    flex-direction: column;
    align-items: stretch;
    min-height: 0;
}

.trading-window__tab-panel {
    flex-grow: 1;
    flex-direction: column;
    align-items: stretch;
    min-height: 0;
}

.trading-window__tab-panel--hidden {
    display: none;
}

.trading-window__scroll {
    flex-grow: 1;
    min-height: 0;
}

.trading-window__list {
    flex-direction: column;
    align-items: stretch;
}

.trading-window__empty-label {
    font-size: 14px;
    color: rgb(140, 136, 142);
    -unity-text-align: middle-center;
    margin-top: 48px;
    margin-bottom: 48px;
}

.trading-window__offer-row,
.trading-window__basket-row {
    flex-direction: row;
    align-items: center;
    min-height: 72px;
    margin-bottom: 10px;
    padding: 10px 12px;
    border-radius: 10px;
    background-color: rgb(38, 35, 40);
    border-width: 1px;
    border-color: rgb(52, 48, 54);
}

.trading-window__offer-output,
.trading-window__basket-output {
    flex-direction: row;
    align-items: center;
    min-width: 108px;
    max-width: 108px;
    margin-right: 12px;
}

.trading-window__inputs-row {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    margin-right: 8px;
}

.trading-window__resource-stack {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 56px;
    margin-right: 6px;
    margin-bottom: 2px;
}

.trading-window__resource-icon {
    width: 40px;
    height: 40px;
    border-radius: 8px;
    background-color: rgb(50, 46, 52);
    -unity-background-scale-mode: scale-to-fit;
    margin-bottom: 4px;
}

.trading-window__resource-amount {
    font-size: 11px;
    color: rgb(200, 196, 202);
    -unity-text-align: middle-center;
    max-width: 56px;
    overflow: hidden;
    text-overflow: ellipsis;
}

.trading-window__resource-name {
    font-size: 10px;
    color: rgb(130, 126, 132);
    -unity-text-align: middle-center;
    max-width: 56px;
    overflow: hidden;
    text-overflow: ellipsis;
}

.trading-window__separator {
    width: 28px;
    min-width: 28px;
    align-items: center;
    justify-content: center;
    margin-left: 4px;
    margin-right: 8px;
}

.trading-window__separator-arrow {
    font-size: 20px;
    color: rgb(90, 200, 250);
    -unity-text-align: middle-center;
}

.trading-window__add-button {
    min-width: 118px;
    height: 36px;
    border-width: 0;
    border-radius: 8px;
    background-color: rgb(58, 120, 160);
    color: rgb(245, 245, 247);
    font-size: 12px;
    -unity-font-style: bold;
}

.trading-window__add-button:hover {
    background-color: rgb(72, 140, 184);
}

.trading-window__add-button--in-basket {
    background-color: rgb(52, 88, 62);
}

.trading-window__basket-meta {
    flex-grow: 1;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    margin-right: 8px;
}

.trading-window__basket-meta-title {
    font-size: 13px;
    color: rgb(220, 216, 222);
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.trading-window__basket-meta-detail {
    font-size: 11px;
    color: rgb(150, 146, 152);
}

.trading-window__basket-controls {
    flex-direction: row;
    align-items: center;
}

.trading-window__quantity-button {
    width: 28px;
    height: 28px;
    min-width: 28px;
    border-width: 0;
    border-radius: 6px;
    background-color: rgb(52, 48, 54);
    color: rgb(235, 232, 236);
    font-size: 16px;
    margin: 0 4px;
}

.trading-window__quantity-label {
    min-width: 24px;
    font-size: 13px;
    -unity-text-align: middle-center;
    color: rgb(235, 232, 236);
}

.trading-window__remove-button {
    min-width: 72px;
    height: 32px;
    border-width: 0;
    border-radius: 8px;
    margin-left: 8px;
    background-color: rgb(92, 48, 52);
    color: rgb(245, 245, 247);
    font-size: 11px;
}

.trading-window__footer {
    flex-direction: column;
    align-items: stretch;
    padding: 12px 24px 20px;
    border-top-width: 1px;
    border-top-color: rgb(48, 44, 50);
    background-color: rgb(24, 22, 26);
}

.trading-window__summary {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
    padding-left: 4px;
    padding-right: 4px;
}

.trading-window__summary-group {
    flex-direction: column;
    align-items: flex-start;
}

.trading-window__summary-label {
    font-size: 11px;
    color: rgb(140, 136, 142);
    margin-bottom: 2px;
}

.trading-window__summary-value {
    font-size: 14px;
    color: rgb(220, 216, 222);
    -unity-font-style: bold;
}

.trading-window__summary-value--accent {
    color: rgb(90, 200, 250);
}

.trading-window__offer-button {
    height: 52px;
    border-width: 0;
    border-radius: 10px;
    background-color: rgb(72, 150, 96);
    color: rgb(245, 245, 247);
    font-size: 16px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.trading-window__offer-button:hover {
    background-color: rgb(86, 170, 112);
}

.trading-window__offer-button:disabled {
    background-color: rgb(56, 52, 58);
    color: rgb(120, 116, 122);
}

.trading-window__templates {
    display: none;
}
